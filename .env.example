# ===== 大模型（OpenAI 兼容协议，任选一家）=====
# DeepSeek 示例：https://api.deepseek.com/v1  /  deepseek-chat
# 通义千问示例：https://dashscope.aliyuncs.com/compatible-mode/v1  /  qwen-plus
# Kimi 示例：https://api.moonshot.cn/v1  /  moonshot-v1-32k
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=5
# 可选：自定义整理提示词模板（留空用内置默认）
# Map 占位符：{Index} {StartTime} {EndTime} {Audience} {Purpose} {ChunkText}
#   LLM_MAP_PROMPT=请提炼第 {Index} 段...\n{ChunkText}
# Reduce 占位符：{Title} {Uploader} {Duration} {Audience} {Purpose} {ChunkResults}
#   LLM_REDUCE_PROMPT=请归纳《{Title}》...\n{ChunkResults}
# 转写纠错：LLM 二次校对 ASR 错别字/同音误识别（false 关闭）
LLM_CORRECT=true
CORRECT_BATCH_SIZE=20
# 单任务最多校对的段数上限（防超长视频成本失控）
CORRECT_MAX_SEGMENTS=500
# 纠错增强档：开启后在修错字基础上优化断句与标点（opt-in，默认只修错字以保引用对齐）
CORRECT_PUNCTUATION=false

# 国内网络访问 HuggingFace 失败时，在系统环境变量设置镜像（非本文件变量）：
#   setx HF_ENDPOINT https://hf-mirror.com    （Windows，新开终端生效）
#   export HF_ENDPOINT=https://hf-mirror.com   （Linux/macOS）
# ===== 语音识别 =====
# 模型越大越准越慢：tiny/small/medium/large-v3
# 支持本地目录：ASR_MODEL=data/models/whisper-small（先用 snapshot_download 预下载）
ASR_MODEL=large-v3
# auto=自动检测 GPU/CPU；也可指定 cuda / cpu
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=int8
# zh/auto(或 none/空)=自动检测；英文等可显式指定 en / ja / ko……
ASR_LANGUAGE=zh
# VAD 过滤静音/纯音乐段；歌曲、纯音乐视频识别不出内容时请设为 false
ASR_VAD_FILTER=true
# auto=优先 faster-whisper，未安装自动切 mock；whisper=强制真实转写；mock=强制模拟（离线联调）
ASR_ENGINE=auto
# VAD 返回空结果时自动回退无 VAD 重跑（修 large-v3+vad 空转写 bug，建议保持 true）
ASR_VAD_FALLBACK=true
# CPU 推理线程数：0=自动吃满全部核（提速关键项；实测本版本并行 transcribe 会互抢，故靠它提速）
ASR_CPU_THREADS=0
# 上下文条件转写：false=快约 2 倍（实测 341s→172s），长句偶发少字但要点/时间戳不受影响；true=逐字精度略高但慢
ASR_CONTEXT_TEXT=false
# 单任务转写超时（秒），0=不限；CPU 跑大模型长视频防无限等待，超时提示换 tiny/base/small 档
ASR_TIMEOUT=1800
# 启动时后台预热 ASR 模型（Hub 名会自动走镜像下载权重），避免首个任务卡几分钟
ASR_PREWARM=true

# ===== 任务限制 =====
# 视频时长上限（秒），0=不限
MAX_VIDEO_DURATION=10800
MAX_CHUNKS=50
CHUNK_TOKENS=3000
OVERLAP_TOKENS=200
MAX_CONCURRENT_ASR=2
# 全局 LLM 并发上限：限制同时进入整理/纠错阶段的任务数（防多任务并发打爆 API 与费用）
MAX_CONCURRENT_LLM_TASKS=2

# ===== 转写级缓存（省钱主力）=====
# 同一视频换深度/用途时复用转写结果，跳过重复下载+转写+纠错
TRANSCRIPT_CACHE=true
# 视频元信息缓存 TTL（秒，0=关闭；换深度重提时省一次 yt-dlp 网络请求）
META_CACHE_TTL=86400
# 数据保留天数：0=不清理；>0 时启动及每日清理超过该天数的任务目录与 DB 记录
DATA_RETENTION_DAYS=0

# ===== LLM 输出 =====
# 单次 LLM 响应 max_tokens 上限（0=不限）
LLM_MAX_TOKENS=0
# 摘要自检：Reduce 输出后 LLM 再评审一遍，发现遗漏关键数据则补充（+1 次调用/任务）
#   off=关闭 / full=仅 full 档启用 / always=所有档启用
SUMMARY_SELF_CHECK=off

# ===== 鉴权 =====
# API Token：非空时 /api/extract 等写操作需带 X-API-Key 头；空=不鉴权（本地开发）
# 公网/局域网部署强烈建议设置，避免他人白嫖你的 LLM 余额
API_TOKEN=

# ===== 下载 =====
# yt-dlp cookies 文件路径（大会员/需登录视频；可用 yt-dlp --cookies-from-browser 导出）
# YTDLP_COOKIES=cookies.txt

# ===== 内置桥（bili-scroll → 提取器 进程内心跳）=====
# 整合后由 uvicorn 进程自带后台心跳，不再依赖外部 Windows 计划任务调 run_bridge.bat。
# 服务启动后每 BRIDGE_INTERVAL 秒扫一次 ~/.dsh/bili-duty/out/*.md，转发指定档位的片到提取器。
# 仅在装有刷B站插件(bili-scroll)且有日报时有意义；纯 Linux/Docker 或不想自动转发可设 false。
BRIDGE_ENABLED=true
# 心跳间隔秒（默认 600 = 10 分钟）
BRIDGE_INTERVAL=600
# 逗号分隔的转发档位（默认只转「值得看」；想加「可以看」写 值得看,可以看）
BRIDGE_TIERS=值得看

# ===== 存储/清理 =====
# 数据目录，留空默认 项目根/data
DATA_DIR=
# true=保留下载的音频/视频中间产物
KEEP_MEDIA=false